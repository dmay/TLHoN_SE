QWidget#equipmentContent { background: #282828; }
QLabel, QGroupBox { color: white; font: 12px sans-serif; }
QGroupBox { border: 1px solid #777; border-radius: 4px; margin-top: 12px; padding-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; }
QComboBox { min-height: 23px; }
